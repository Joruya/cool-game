}

async function endGameAndGenerate() {
  if (!confirm('確定結束遊戲並生成 AI 解讀？')) return;
  loading(true);
  await fbPatch(`/rooms/${state.roomCode}`, { status: 'ended' });

  // Trigger AI interpretation for each player via Claude API
  for (const [pid, player] of Object.entries(state.players)) {
    for (const type of ['body','mind','spirit','all']) {
      try {
        const interp = await generateInterpretation(player, type);
        await fbPatch(`/rooms/${state.roomCode}/players/${pid}`, { [`interpret_${type}`]: interp });
      } catch(e) { console.error('Interpretation error', e); }
    }
  }
  loading(false);
  toast('解讀已生成並存入 Firebase ✓', 'success');
  document.getElementById('dashStatus').textContent = '遊戲結束';
}

async function generateInterpretation(player, type) {
  const typeMap = { body:'身體層面（身）', mind:'心理層面（心）', spirit:'靈性層面（靈）', all:'身心靈綜合解讀' };
  const cards = Object.values(player.cards||{});
  const cardList = cards.map(c=>`${cardTypeLabel(c.type)}：${c.name}${c.orientation?'（'+c.orientation+'）':''}${c.impression?'　感想：'+c.impression:''}`).join('\n');
  const hd = player.humanDesign || {};

  const prompt = `你是一位整合人類圖、塔羅牌與答案桌遊的靈性解讀師，以溫暖、深刻、有洞見的方式進行解讀。

玩家資料：
- 別名：${player.alias}
- 主題：${player.theme || '未填'}
- 元素：${ELEM_ICON[player.element]||''} ${player.element||'未填'}
- 人類圖類型：${hd.type || '未填'}
- 策略：${hd.strategy || '未填'}
- 內在權威：${hd.authority || '未填'}
${hd.profile?`- Profile：${hd.profile}`:''}
${hd.channel?`- 主題通道：${hd.channel}`:''}

本局牌面：
${cardList || '（無牌面資料）'}

請進行【${typeMap[type]}】解讀，約400-500字，需：
1. 整合玩家的人類圖特質
2. 解讀牌面呈現的訊息
3. 給出具體的行動建議或內在洞見
4. 語氣溫暖、支持性強

請直接開始解讀，不需前言。`;

  const res = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: { 'Content-Type':'application/json', 'anthropic-version':'2023-06-01' },
    body: JSON.stringify({ model:'claude-sonnet-4-20250514', max_tokens:1000, messages:[{role:'user',content:prompt}] })
  });
  const data = await res.json();
  return data.content?.[0]?.text || '解讀生成失敗';
}

// ═══════════════════════════════════════════════════════════════════
// PLAYER: Join room
// ═══════════════════════════════════════════════════════════════════
async function joinRoom() {
  const code = document.getElementById('playerRoomCode').value.toUpperCase().trim();
  const alias = document.getElementById('playerAlias').value.trim();
  if (!code || code.length < 4) { toast('請輸入有效房間碼','error'); return; }
  if (!alias) { toast('請輸入別名','error'); return; }

  loading(true);
  const room = await fbGet(`/rooms/${code}`);
  if (!room) { loading(false); toast('找不到此房間','error'); return; }
  if (room.status === 'ended') { loading(false); toast('此場次已結束','error'); return; }

  // Create player record
  const res = await fbPush(`/rooms/${code}/players`, {
    alias, initDone: false, cards: {}, nobles: 0,
    humanDesign: {}, theme: '', element: '',
    joinedAt: Date.now()
  });
  state.playerId = res.name;
  state.roomCode = code;
  state.alias = alias;
  state.room = room;
  loading(false);

  showScreen('screen-player-init');
  initInitSteps();
}

// ═══════════════════════════════════════════════════════════════════
// PLAYER: Multi-step init
// ═══════════════════════════════════════════════════════════════════
function initInitSteps() {
  goInitStep(0);
}

function goInitStep(n) {
  state.initStep = n;
  for (let i = 0; i < 3; i++) {
    document.getElementById(`init-step-${i}`).classList.toggle('hidden', i !== n);
    const dot = document.getElementById(`dot-${i}`);
    dot.classList.toggle('active', i === n);
    dot.classList.toggle('done', i < n);
  }
  document.getElementById('initStepLabel').textContent = `步驟 ${n+1} / 3`;
}

function initStep(n) {
  if (n === 1) {
    // Validate step 0
    if (!document.querySelector('input[name="element"]:checked')) {
      toast('請選擇元素','error'); return;
    }
  }
  if (n === 2) {
    // Build summary
    const hdType = document.getElementById('hd-type').value;
    const hdStrategy = document.getElementById('hd-strategy').value;
    const hdAuth = document.getElementById('hd-authority').value;
    const hdProfile = document.getElementById('hd-profile').value;
    const hdDef = document.querySelector('input[name="hd-def"]:checked')?.value;
    const hdChannel = document.getElementById('hd-channel').value;
    const theme = document.getElementById('p-theme').value.trim();
    const elem = document.querySelector('input[name="element"]:checked')?.value;

    document.getElementById('initSummary').innerHTML = `
      <div>🎯 主題：${theme || '未填'}</div>
      <div>${ELEM_ICON[elem]||''} 元素：${elem || '未填'}</div>
      <div>─────</div>
      <div>🔷 類型：${hdType || '未填'}</div>
      <div>🔶 策略：${hdStrategy || '未填'}</div>
      <div>💜 權威：${hdAuth || '未填'}</div>
      ${hdProfile?`<div>👤 Profile：${hdProfile}</div>`:''}
      ${hdDef?`<div>🔗 定義：${hdDef}定義</div>`:''}
      ${hdChannel?`<div>📡 通道：${hdChannel}</div>`:''}
    `;
  }
  goInitStep(n);
}

async function submitPlayerInit() {
  const theme = document.getElementById('p-theme').value.trim();
  const elem = document.querySelector('input[name="element"]:checked')?.value;
  const hd = {
    type: document.getElementById('hd-type').value,
    strategy: document.getElementById('hd-strategy').value,
    authority: document.getElementById('hd-authority').value,
    profile: document.getElementById('hd-profile').value,
    definition: document.querySelector('input[name="hd-def"]:checked')?.value || '',
    channel: document.getElementById('hd-channel').value,
    sunGate: document.getElementById('hd-sun').value,
    moonGate: document.getElementById('hd-moon').value,
    lifeTheme: document.getElementById('hd-theme').value,
  };

  loading(true);
  await fbPatch(`/rooms/${state.roomCode}/players/${state.playerId}`, {
    theme, element: elem, humanDesign: hd, initDone: true
  });
  loading(false);
  toast('資料已送出 ✓', 'success');
  enterPlayerGame();
}

// ═══════════════════════════════════════════════════════════════════
// PLAYER: Game screen
// ═══════════════════════════════════════════════════════════════════
function enterPlayerGame() {
  showScreen('screen-player-game');
  document.getElementById('playerGameRoom').textContent = `房間：${state.roomCode}`;
  document.getElementById('playerAliasBadge').textContent = state.alias;
  startPlayerPoll();
}

async function startPlayerPoll() {
  if (state.pollInterval) clearInterval(state.pollInterval);
  await refreshPlayerGame();
  state.pollInterval = setInterval(refreshPlayerGame, 3000);
}

let lastGuideTs = 0;
let lastPromptTs = 0;

async function refreshPlayerGame() {
  const player = await fbGet(`/rooms/${state.roomCode}/players/${state.playerId}`);
  if (!player) return;

  // Check room status
  const roomStatus = await fbGet(`/rooms/${state.roomCode}/status`);
  if (roomStatus === 'ended') {
    clearInterval(state.pollInterval);
    enterGameEnd(player);
    return;
  }

  // Update cards
  renderMyCards(player);
  renderPassBar(player);

  // Guide question notification
  const gq = player.guideQuestion;
  if (gq && gq.ts > lastGuideTs) {
    lastGuideTs = gq.ts;
    showGuideNotif(gq);
  }

  // Impression prompt
  const ap = player.activePrompt;
  if (ap && ap.ts > lastPromptTs) {
    lastPromptTs = ap.ts;
    showImpressionModal(ap);
  }

  // Cosmic gift check
  const roomData = await fbGet(`/rooms/${state.roomCode}`);
  checkCosmicGift(player, roomData);
}

function renderMyCards(player) {
  const cards = Object.entries(player.cards || {});
  const grid = document.getElementById('myCardsGrid');
  document.getElementById('myCardCount').textContent = `${cards.length} 張`;

  if (!cards.length) {
    grid.innerHTML = '<div style="font-size:13px;color:var(--text3);text-align:center;padding:24px;grid-column:1/-1">等待主持人給牌…</div>';
    return;
  }
  grid.innerHTML = cards.map(([cid, c]) => {
    const isRev = c.orientation === '逆位';
    return `<div class="game-card ${isRev?'reversed':''}" onclick="openImpression('${cid}','${c.name}','${c.prompt||''}','${c.impression||''}')">
      <span class="card-type-icon">${CARD_TYPE_ICONS[c.type]||'🃏'}</span>
      <div class="card-type">${cardTypeLabel(c.type)}</div>
      <div class="card-name">${c.name}</div>
      ${c.orientation?`<div class="card-orient" style="color:${isRev?'var(--red)':'var(--green)'}">${c.orientation}</div>`:''}
      ${c.impression
        ? `<div class="card-impression">「${c.impression}」</div>`
        : `<div style="font-size:11px;color:var(--accent);margin-top:6px">點此填感想</div>`}
    </div>`;
  }).join('');
}

function renderPassBar(player) {
  const cards = Object.values(player.cards || {});
  const msgCards = cards.filter(c => c.type !== 'noble').length;
  const bar = document.getElementById('passBar');
  const status = document.getElementById('passStatus');

  const hasTarot = cards.some(c => ['explore','truth','fortune'].includes(c.type));
  const hasTopic = cards.some(c => c.type === 'topic');
  const hasGuide = cards.some(c => c.type === 'guide');
  const hasNoble = (player.nobles||0) >= 1;
  const cond1 = hasTarot && hasTopic && hasGuide && hasNoble;
  const cond2 = msgCards >= 7;
  const forced = msgCards >= 9;

  bar.innerHTML = Array(9).fill(0).map((_,i)=>`<div class="pass-dot ${i<msgCards?'filled':''}"></div>`).join('');

  if (forced) status.textContent = '⚡ 強制過關！';
  else if (cond1||cond2) status.textContent = '✅ 可以過關了！';
  else status.textContent = `${msgCards} / 7 張訊息卡`;
}

function showGuideNotif(gq) {
  const area = document.getElementById('guideNotifArea');
  area.innerHTML = `<div class="notification-banner fade-in">
    <div class="notif-title">💬 ${gq.from} 的引導問題</div>
    <div class="notif-body">${gq.text}</div>
  </div>`;
}

function openImpression(cardId, cardName, prompt, existing) {
  state.impressionCardId = cardId;
  document.getElementById('impressionCardName').textContent = `✍️ ${cardName}`;
  document.getElementById('impressionPrompt').textContent = prompt || '這張牌帶給你什麼感覺？';
  document.getElementById('impressionText').value = existing || '';
  openModal('modalImpression');
}

function showImpressionModal(ap) {
  if (!ap.cardId) return;
  openImpression(ap.cardId, ap.cardName, ap.text, '');
}

async function submitImpression() {
  const text = document.getElementById('impressionText').value.trim();
  if (!text) { toast('請填寫感想','error'); return; }
  if (!state.impressionCardId) return;

  loading(true);
  await fbPatch(`/rooms/${state.roomCode}/players/${state.playerId}/cards/${state.impressionCardId}`, {
    impression: text
  });
  loading(false);
  closeModal('modalImpression');
  toast('感想已送出 ✓', 'success');
  await refreshPlayerGame();
}

function checkCosmicGift(player, room) {
  if (!room) return;
  const gamePhase = room.phase || 'body';
  if (!['mind','spirit'].includes(gamePhase)) return;

  const prevNobles = room.nobles || 0;
  if (prevNobles < 2) return;

  const giftCount = prevNobles - 1;
  const area = document.getElementById('cosmicGiftArea');
  area.classList.remove('hidden');
  area.innerHTML = `<div class="guide-panel fade-in">
    <div class="guide-meta">🌌 宇宙送牌提示</div>
    <div class="guide-q">本局貴人代幣達 ${prevNobles} 個，宇宙將為你送出 ${giftCount} 張牌</div>
  </div>`;
}

// ═══════════════════════════════════════════════════════════════════
// PLAYER: Game end
// ═══════════════════════════════════════════════════════════════════
async function enterGameEnd(player) {
  showScreen('screen-game-end');
  state.currentInterpretType = 'body';

  // Check if interpretations already exist
  if (player.interpret_body || player.interpret_all) {
    document.getElementById('interpretSection').classList.remove('hidden');
    showInterpret(player, 'body');
  }
}

function switchInterpret(type) {
  document.querySelectorAll('#interpretTabs .tab').forEach((t,i) => {
    t.classList.toggle('active', ['body','mind','spirit','all'][i] === type);
  });
  state.currentInterpretType = type;
  (async () => {
    const player = await fbGet(`/rooms/${state.roomCode}/players/${state.playerId}`);
    if (player) showInterpret(player, type);
  })();
}

function showInterpret(player, type) {
  const content = document.getElementById('interpretContent');
  const text = player[`interpret_${type}`];
  content.textContent = text || '解讀尚未生成，請稍待主持人完成…';
}

