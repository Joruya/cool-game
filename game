<script>
// ═══════════════════════════════════════════════════════════════════
// CONFIG
// ═══════════════════════════════════════════════════════════════════
const FB_URL = 'https://joruyagame-default-rtdb.asia-southeast1.firebasedatabase.app';

// ── Card data ──────────────────────────────────────────────────────
const MAJOR_ARCANA = ['愚者','魔術師','女祭司','女皇','皇帝','教皇','戀人','戰車','力量','隱士','命運之輪','正義','倒吊人','死神','節制','惡魔','高塔','星星','月亮','太陽','審判','世界'];
const MINOR_SUITS = {
  fire:  ['權杖Ace','權杖2','權杖3','權杖4','權杖5','權杖6','權杖7','權杖8','權杖9','權杖10','權杖侍從','權杖騎士','權杖皇后','權杖國王'],
  water: ['聖杯Ace','聖杯2','聖杯3','聖杯4','聖杯5','聖杯6','聖杯7','聖杯8','聖杯9','聖杯10','聖杯侍從','聖杯騎士','聖杯皇后','聖杯國王'],
  earth: ['星幣Ace','星幣2','星幣3','星幣4','星幣5','星幣6','星幣7','星幣8','星幣9','星幣10','星幣侍從','星幣騎士','星幣皇后','星幣國王'],
  air:   ['寶劍Ace','寶劍2','寶劍3','寶劍4','寶劍5','寶劍6','寶劍7','寶劍8','寶劍9','寶劍10','寶劍侍從','寶劍騎士','寶劍皇后','寶劍國王'],
};
const CARD_TYPE_ICONS = { explore:'🌕', truth:'⭐', topic:'📋', guide:'🧭', fortune:'☯️', noble:'🌟', message:'💌' };
const ELEM_ICON = { fire:'🔥', water:'💧', earth:'🌿', air:'🌬' };

// ═══════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════
let state = {
  role: null,           // 'host' | 'player'
  roomCode: null,
  playerId: null,
  alias: null,
  currentPlayerTab: 0,  // host dashboard active player index
  initStep: 0,
  players: {},          // live mirror from Firebase
  room: null,
  impressionCardId: null,
  listeners: [],
  pollInterval: null,
};

// ═══════════════════════════════════════════════════════════════════
// FIREBASE helpers
// ═══════════════════════════════════════════════════════════════════
async function fbGet(path) {
  const r = await fetch(`${FB_URL}${path}.json`);
  return r.json();
}
async function fbSet(path, data) {
  const r = await fetch(`${FB_URL}${path}.json`, { method:'PUT', body:JSON.stringify(data) });
  return r.json();
}
async function fbPatch(path, data) {
  const r = await fetch(`${FB_URL}${path}.json`, { method:'PATCH', body:JSON.stringify(data) });
  return r.json();
}
async function fbPush(path, data) {
  const r = await fetch(`${FB_URL}${path}.json`, { method:'POST', body:JSON.stringify(data) });
  return r.json();
}

// ═══════════════════════════════════════════════════════════════════
// SCREEN routing
// ═══════════════════════════════════════════════════════════════════
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  const el = document.getElementById(id);
  if (el) { el.classList.add('active'); el.classList.add('fade-in'); }
}

function loading(show) {
  document.getElementById('loadingScreen').classList.toggle('hidden', !show);
}

function toast(msg, type='') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'show' + (type ? ' '+type : '');
  setTimeout(() => t.className = '', 2800);
}

function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

// ═══════════════════════════════════════════════════════════════════
// WELCOME
// ═══════════════════════════════════════════════════════════════════
function goHostEntry() { state.role='host'; showScreen('screen-host-entry'); }
function goPlayerEntry() { state.role='player'; showScreen('screen-player-entry'); }

function switchHostTab(tab) {
  document.getElementById('hostCreate').classList.toggle('hidden', tab!=='create');
  document.getElementById('hostJoin').classList.toggle('hidden', tab!=='join');
  document.querySelectorAll('#hostEntryTabs .tab').forEach((t,i) => {
    t.classList.toggle('active', (i===0&&tab==='create')||(i===1&&tab==='join'));
  });
}

// ═══════════════════════════════════════════════════════════════════
// HOST: create room
// ═══════════════════════════════════════════════════════════════════
function genRoomCode() {
  return Math.random().toString(36).substring(2,8).toUpperCase();
}

async function createRoom() {
  const hostName = document.getElementById('hostName').value.trim();
  const sessionTheme = document.getElementById('sessionTheme').value.trim();
  if (!hostName) { toast('請填寫主持人名稱','error'); return; }

  loading(true);
  const code = genRoomCode();
  const roomData = {
    code,
    hostName,
    sessionTheme: sessionTheme || '',
    status: 'waiting',
    createdAt: Date.now(),
    players: {},
    usedTopics: {}
  };
  await fbSet(`/rooms/${code}`, roomData);
  state.roomCode = code;
  state.role = 'host';
  loading(false);

  document.getElementById('displayRoomCode').textContent = code;
  const link = `${location.origin}?room=${code}`;
  document.getElementById('joinLink').textContent = link;
  showScreen('screen-room-created');
  startWaitingPoll();
}

async function rejoinRoom() {
  const code = document.getElementById('rejoinCode').value.toUpperCase().trim();
  if (code.length < 4) { toast('請輸入房間碼','error'); return; }
  loading(true);
  const room = await fbGet(`/rooms/${code}`);
  loading(false);
  if (!room) { toast('找不到此房間','error'); return; }
  state.roomCode = code;
  state.room = room;
  state.role = 'host';
  enterDashboard();
}

function copyRoomCode() {
  navigator.clipboard.writeText(state.roomCode).then(()=>toast('房間碼已複製 ✓','success'));
}
function copyJoinLink() {
  const link = `${location.origin}?room=${state.roomCode}`;
  navigator.clipboard.writeText(link).then(()=>toast('連結已複製 ✓','success'));
}

async function startWaitingPoll() {
  if (state.pollInterval) clearInterval(state.pollInterval);
  state.pollInterval = setInterval(async () => {
    if (!state.roomCode) return;
    const players = await fbGet(`/rooms/${state.roomCode}/players`);
    if (!players) return;
    const list = Object.values(players);
    document.getElementById('playerCount').textContent = `${list.length} 人`;
    const ul = document.getElementById('waitingPlayerList');
    ul.innerHTML = list.length
      ? list.map(p=>`<div style="padding:4px 0;color:var(--text2)">• ${p.alias} <span style="color:var(--text3);font-size:11px">${p.initDone?'✓ 已填資料':''}</span></div>`).join('')
      : '<div style="color:var(--text3)">尚無玩家加入…</div>';
  }, 3000);
}

async function startGame() {
  if (!state.roomCode) return;
  loading(true);
  await fbPatch(`/rooms/${state.roomCode}`, { status:'playing' });
  loading(false);
  clearInterval(state.pollInterval);
  enterDashboard();
}

// ═══════════════════════════════════════════════════════════════════
// HOST: Dashboard
// ═══════════════════════════════════════════════════════════════════
function enterDashboard() {
  showScreen('screen-dashboard');
  document.getElementById('dashRoomCode').textContent = `房間碼：${state.roomCode}`;
  startDashboardPoll();
}

async function startDashboardPoll() {
  if (state.pollInterval) clearInterval(state.pollInterval);
  await refreshDashboard();
  state.pollInterval = setInterval(refreshDashboard, 4000);
}

async function refreshDashboard() {
  const room = await fbGet(`/rooms/${state.roomCode}`);
  if (!room) return;
  state.room = room;
  state.players = room.players || {};
  renderPlayerNav();
  renderDashboardContent();
}

function renderPlayerNav() {
  const nav = document.getElementById('playerNav');
  const playerList = Object.entries(state.players);
  if (!playerList.length) {
    nav.innerHTML = '<div style="font-size:13px;color:var(--text3);padding:8px">尚無玩家</div>';
    return;
  }
  nav.innerHTML = playerList.map(([pid, p], i) => {
    const cards = Object.values(p.cards || {});
    const msgCards = cards.filter(c => !['noble','message_only'].includes(c.type) || c.type === 'fortune').length;
    const nobles = cards.filter(c => c.type === 'noble').length;
    const active = i === state.currentPlayerTab ? 'active' : '';
    return `<button class="player-tab ${active}" onclick="switchPlayerTab(${i})">
      ${p.alias}
      <div class="pt-badges">
        <span style="font-size:10px;color:var(--text3)">${msgCards}張</span>
        ${nobles>0?`<span style="font-size:10px;color:var(--accent2)">🌟×${nobles}</span>`:''}
      </div>
    </button>`;
  }).join('');
}

function switchPlayerTab(i) {
  state.currentPlayerTab = i;
  renderPlayerNav();
  renderDashboardContent();
}

function renderDashboardContent() {
  const content = document.getElementById('dashboardContent');
  const playerList = Object.entries(state.players);
  if (!playerList.length) {
    content.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text3)">等待玩家加入並填寫資料…</div>';
    return;
  }
  const idx = Math.min(state.currentPlayerTab, playerList.length - 1);
  const [pid, player] = playerList[idx];
  const cards = Object.entries(player.cards || {});
  const hd = player.humanDesign || {};
  const msgCount = calcMsgCards(player);
  const nobles = (player.nobles || 0);

  content.innerHTML = `
    <div class="fade-in">
      <!-- Player info -->
      <div class="card-sm mb-12">
        <div class="flex justify-between items-center">
          <div>
            <div class="title-md">${player.alias}</div>
            <div class="subtitle">${player.theme || '無主題'}</div>
          </div>
          <div style="text-align:right">
            <div class="badge" style="background:rgba(160,124,255,0.1);color:var(--accent)">${ELEM_ICON[player.element]||''} ${player.element||'—'}</div>
            ${hd.type?`<div style="font-size:11px;color:var(--text3);margin-top:4px">${hd.type} · ${hd.strategy||''}</div>`:''}
          </div>
        </div>
        ${hd.profile||hd.definition||hd.channel?`
        <div class="divider"></div>
        <div style="font-size:12px;color:var(--text3)">
          ${hd.profile?`Profile: ${hd.profile} `:''} ${hd.definition?`· ${hd.definition}定義 `:''} ${hd.channel?`· ${hd.channel}`:''}</div>
        `:''}</div>

      <!-- Pass status -->
      <div class="pass-bar mb-12" id="dashPassBar${pid}"></div>
      <div style="font-size:12px;color:var(--text3);margin-bottom:12px" id="dashPassStatus${pid}"></div>

      <!-- Cards -->
      <div class="label mb-8">牌面（${cards.length} 張）</div>
      ${cards.length ? `<div class="card-grid">${cards.map(([cid,c]) => renderDashCard(pid, cid, c)).join('')}</div>`
        : '<div style="font-size:13px;color:var(--text3);text-align:center;padding:20px">尚無牌面</div>'}

      <!-- Quick actions for this player -->
      <div class="flex gap-8 mt-12" style="flex-wrap:wrap">
        <button class="btn btn-secondary btn-sm" onclick="quickAddCard('${pid}')">＋ 加牌</button>
        <button class="btn btn-secondary btn-sm" onclick="quickGuide('${pid}', '${player.alias}')">💬 引導問題</button>
        <button class="btn btn-secondary btn-sm" onclick="quickNoble('${pid}')">🌟 貴人代幣 (${nobles})</button>
      </div>
    </div>`;

  renderDashPassBar(pid, player);
}

function renderDashCard(pid, cid, card) {
  const isRev = card.orientation === '逆位';
  return `<div class="game-card ${isRev?'reversed':''}" onclick="viewCardDetail('${pid}','${cid}')">
    <span class="card-type-icon">${CARD_TYPE_ICONS[card.type]||'🃏'}</span>
    <div class="card-type">${cardTypeLabel(card.type)}</div>
    <div class="card-name">${card.name}</div>
    ${card.orientation?`<div class="card-orient" style="color:${isRev?'var(--red)':'var(--green)'}">${card.orientation}</div>`:''}
    ${card.impression?`<div class="card-impression">「${card.impression}」</div>`:''}
  </div>`;
}

function cardTypeLabel(t) {
  return {explore:'探索卡',truth:'真相卡',topic:'議題卡',guide:'指引卡',fortune:'命運之輪',noble:'貴人代幣',message:'訊息卡'}[t]||t;
}

function calcMsgCards(player) {
  const cards = Object.values(player.cards || {});
  return cards.filter(c => !['noble'].includes(c.type)).length;
}

function renderDashPassBar(pid, player) {
  const cards = Object.values(player.cards || {});
  const nobles = player.nobles || 0;
  const msgCards = calcMsgCards(player);

  // Condition check
  const hasTarot = cards.some(c => ['explore','truth','fortune'].includes(c.type));
  const hasTopic = cards.some(c => c.type === 'topic');
  const hasGuide = cards.some(c => c.type === 'guide');
  const hasNoble = nobles >= 1;
  const cond1 = hasTarot && hasTopic && hasGuide && hasNoble;
  const cond2 = msgCards >= 7;
  const forced = msgCards >= 9;
  const passed = cond1 || cond2 || forced;

  const bar = document.getElementById(`dashPassBar${pid}`);
  const status = document.getElementById(`dashPassStatus${pid}`);
  if (!bar) return;

  const dots = Array(Math.min(msgCards, 9)).fill(0).map((_,i)=>`<div class="pass-dot filled"></div>`).join('')
    + Array(Math.max(0,9-msgCards)).fill(0).map(()=>`<div class="pass-dot"></div>`).join('');
  bar.innerHTML = dots;

  let statusText = '';
  if (forced) statusText = '⚡ 強制過關（≥9張）';
  else if (passed) statusText = `✅ 可過關 ${cond1?'（條件①）':''}${cond2?'（條件②）':''}`;
  else {
    const missing = [];
    if (!hasTarot) missing.push('塔羅牌');
    if (!hasTopic) missing.push('議題卡');
    if (!hasGuide) missing.push('指引卡');
    if (!hasNoble) missing.push('貴人代幣×1');
    statusText = `缺：${missing.join('、')} ｜ 訊息卡 ${msgCards}/7`;
  }
  if(status) status.textContent = statusText;
}

// ═══════════════════════════════════════════════════════════════════
// HOST: Add card modal
// ═══════════════════════════════════════════════════════════════════
function showAddCardModal(targetPid) {
  populatePlayerSelect('addCardPlayer', targetPid);
  onCardTypeChange();
  openModal('modalAddCard');
}

function quickAddCard(pid) { showAddCardModal(pid); }

function populatePlayerSelect(selectId, targetPid) {
  const sel = document.getElementById(selectId);
  sel.innerHTML = Object.entries(state.players).map(([pid,p]) =>
    `<option value="${pid}" ${pid===targetPid?'selected':''}>${p.alias}</option>`
  ).join('');
}

function onCardTypeChange() {
  const type = document.getElementById('addCardType').value;
  document.getElementById('addCardTarot').classList.toggle('hidden', !['explore','truth'].includes(type));
  document.getElementById('addCardTopic').classList.toggle('hidden', type !== 'topic');
  document.getElementById('addCardGuide').classList.toggle('hidden', type !== 'guide');

  const nameSelect = document.getElementById('addCardName');
  if (type === 'explore') {
    nameSelect.innerHTML = MAJOR_ARCANA.map(n=>`<option>${n}</option>`).join('');
  } else if (type === 'truth') {
    const rolled = Math.ceil(Math.random() * 4);
    const suitKey = ['fire','water','earth','air'][rolled-1];
    nameSelect.innerHTML = MINOR_SUITS[suitKey].map(n=>`<option>${n}</option>`).join('');
  }
}

async function submitAddCard() {
  const pid = document.getElementById('addCardPlayer').value;
  const type = document.getElementById('addCardType').value;
  const prompt = document.getElementById('addCardPrompt').value.trim();
  let cardData = { type, addedAt: Date.now(), impression: '', prompt };

  if (['explore','truth'].includes(type)) {
    cardData.name = document.getElementById('addCardName').value;
    cardData.orientation = document.querySelector('input[name="orient"]:checked')?.value || '正位';
  } else if (type === 'topic') {
    const text = document.getElementById('addTopicText').value.trim();
    if (!text) { toast('請填寫議題卡內容','error'); return; }
    // Check used topics
    const used = state.room?.usedTopics || {};
    if (used[text]) { toast('此議題卡已使用過','error'); return; }
    cardData.name = text;
    await fbPatch(`/rooms/${state.roomCode}/usedTopics`, { [text]: true });
  } else if (type === 'guide') {
    const elem = document.querySelector('input[name="guideElem"]:checked')?.value || 'fire';
    const num = document.getElementById('addGuideNum').value || '1';
    cardData.name = `${ELEM_ICON[elem]}指引卡 ${num}`;
    cardData.element = elem;
  } else if (type === 'fortune') {
    cardData.name = '命運之輪';
  } else if (type === 'noble') {
    cardData.name = '貴人代幣';
  } else {
    cardData.name = document.getElementById('addCardName')?.value || '訊息卡';
  }

  loading(true);
  const cardId = `card_${Date.now()}`;
  await fbSet(`/rooms/${state.roomCode}/players/${pid}/cards/${cardId}`, cardData);
  // Push impression prompt if set
  if (prompt) {
    await fbPatch(`/rooms/${state.roomCode}/players/${pid}`, {
      activePrompt: { text: prompt, cardId, cardName: cardData.name, ts: Date.now() }
    });
  }
  loading(false);
  closeModal('modalAddCard');
  toast(`已給 ${state.players[pid]?.alias} 加牌：${cardData.name}`, 'success');
  await refreshDashboard();
}

// ═══════════════════════════════════════════════════════════════════
// HOST: Guide question
// ═══════════════════════════════════════════════════════════════════
function showGuideModal() {
  populatePlayerSelect('guideTarget');
  const sel = document.getElementById('guideTarget');
  sel.innerHTML = '<option value="all">全體玩家</option>' + sel.innerHTML;
  openModal('modalGuide');
}
function quickGuide(pid, alias) {
  populatePlayerSelect('guideTarget', pid);
  openModal('modalGuide');
}
function setGuideTemplate(text) { document.getElementById('guideText').value = text; }

async function submitGuideQuestion() {
  const target = document.getElementById('guideTarget').value;
  const text = document.getElementById('guideText').value.trim();
  if (!text) { toast('請輸入引導問題','error'); return; }

  const payload = { text, from: state.room?.hostName || '主持人', ts: Date.now() };
  loading(true);
  if (target === 'all') {
    for (const pid of Object.keys(state.players)) {
      await fbPatch(`/rooms/${state.roomCode}/players/${pid}`, { guideQuestion: payload });
    }
  } else {
    await fbPatch(`/rooms/${state.roomCode}/players/${target}`, { guideQuestion: payload });
  }
  loading(false);
  closeModal('modalGuide');
  toast('引導問題已發送 ✓', 'success');
  document.getElementById('guideText').value = '';
}

// ═══════════════════════════════════════════════════════════════════
// HOST: Noble token & ritual
// ═══════════════════════════════════════════════════════════════════
function addNobleToken() {
  populatePlayerSelect('noblePlayerA');
  populatePlayerSelect('noblePlayerB');
  openModal('modalNoble');
}
function quickNoble(pid) {
  populatePlayerSelect('noblePlayerA', pid);
