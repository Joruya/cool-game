}

async function submitNobleRitual() {
  const pidA = document.getElementById('noblePlayerA').value;
  const pidB = document.getElementById('noblePlayerB').value;
  const promptA = document.getElementById('nobleAPrompt').value.trim();
  if (pidA === pidB) { toast('A 與 B 必須是不同玩家','error'); return; }

  loading(true);
  // nobles +1 (主持人)
  const currentNobles = state.room?.nobles || 0;
  await fbPatch(`/rooms/${state.roomCode}`, { nobles: currentNobles + 1 });

  // A: 感想提示（不計訊息卡）
  if (promptA) {
    await fbPatch(`/rooms/${state.roomCode}/players/${pidA}`, {
      activePrompt: { text: promptA, cardId: null, cardName: '貴人格指定', ts: Date.now() }
    });
