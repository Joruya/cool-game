.role-card:hover{border-color:var(--accent);transform:translateY(-3px);box-shadow:var(--glow)}
.role-card .role-icon{font-size:36px;display:block;margin-bottom:12px}
.role-card .role-name{font-size:15px;font-weight:700;color:var(--text)}
.role-card .role-desc{font-size:12px;color:var(--text3);margin-top:6px}

/* ── Host create room ───────────────────────────────────────────────── */
.room-code-display{font-size:48px;font-weight:800;letter-spacing:.2em;color:var(--gold);text-align:center;font-family:monospace;text-shadow:0 0 20px rgba(240,201,122,0.3)}

/* ── Dashboard layout ───────────────────────────────────────────────── */
#screen-dashboard{background:var(--bg)}
.dashboard-content{flex:1;padding:16px;overflow-y:auto;min-height:0}
.dashboard-footer{padding:12px 20px;border-top:1px solid var(--border);background:var(--bg2);display:flex;gap:8px;flex-wrap:wrap}

/* ── Player screen ──────────────────────────────────────────────────── */
.player-content{flex:1;padding:16px;overflow-y:auto}
.notification-banner{background:linear-gradient(135deg,rgba(160,124,255,0.15),rgba(255,143,203,0.1));border:1px solid rgba(160,124,255,0.35);border-radius:var(--radius);padding:14px 16px;margin-bottom:12px;animation:fadeIn .3s}
.notification-banner .notif-title{font-size:13px;font-weight:700;color:var(--accent);margin-bottom:4px}
.notification-banner .notif-body{font-size:13px;color:var(--text)}

/* ── Game end / LINE ────────────────────────────────────────────────── */
.line-section{background:linear-gradient(135deg,var(--bg2),var(--surface));border:1px solid rgba(107,255,184,0.2);border-radius:var(--radius);padding:24px;text-align:center}
.line-logo{font-size:40px;margin-bottom:12px}
</style>
</head>
<body>
<div class="stars-bg"></div>

<!-- Loading -->
<div class="loading-screen" id="loadingScreen">
  <div class="spinner"></div>
  <div style="color:var(--text2);font-size:13px">載入中…</div>
</div>

<!-- Toast -->
<div id="toast"></div>

<div id="app">

<!-- ═══════════════════════════════════════════════════════════════════
  SCREEN 1：歡迎頁
════════════════════════════════════════════════════════════════════ -->
<div class="screen" id="screen-welcome">
  <div class="page-center z-1">
    <div style="width:100%;max-width:420px">
      <div id="screen-welcome" class="logo-wrap">
        <span class="logo-icon">🌌</span>
        <div class="title-xl">身心靈桌遊</div>
        <div class="tagline">人類圖 × 答案桌遊 × 塔羅 整合解讀系統</div>
      </div>
      <div class="role-cards fade-in">
        <div class="role-card" onclick="goHostEntry()">
          <span class="role-icon">🎴</span>
          <div class="role-name">主持人</div>
          <div class="role-desc">建立房間<br>管理遊戲</div>
        </div>
        <div class="role-card" onclick="goPlayerEntry()">
          <span class="role-icon">🌸</span>
          <div class="role-name">玩家</div>
          <div class="role-desc">加入房間<br>開始旅程</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
  SCREEN 2：主持人入口（建立/加入房間）
════════════════════════════════════════════════════════════════════ -->
<div class="screen" id="screen-host-entry">
  <div class="page-center z-1">
    <div style="width:100%;max-width:420px">
      <button class="btn btn-ghost btn-sm mb-16" onclick="showScreen('screen-welcome')">← 返回</button>
      <div class="title-lg mb-8">主持人入口</div>
      <div class="subtitle mb-16">建立新房間或繼續既有場次</div>

      <div class="card">
        <div class="tabs mb-16" id="hostEntryTabs">
          <button class="tab active" onclick="switchHostTab('create')">建立新房間</button>
          <button class="tab" onclick="switchHostTab('join')">繼續場次</button>
        </div>

        <!-- 建立 -->
        <div id="hostCreate">
          <div class="form-group">
            <div class="label">主持人名稱</div>
            <input class="input" id="hostName" placeholder="例：Joruya" maxlength="20">
          </div>
          <div class="form-group">
            <div class="label">場次主題（選填）</div>
            <input class="input" id="sessionTheme" placeholder="例：秋分轉化工作坊">
          </div>
          <button class="btn btn-primary btn-full mt-8" onclick="createRoom()">✨ 建立房間</button>
        </div>

        <!-- 繼續 -->
        <div id="hostJoin" class="hidden">
          <div class="form-group">
            <div class="label">房間碼</div>
            <input class="input" id="rejoinCode" placeholder="輸入6位房間碼" maxlength="6" style="text-transform:uppercase;font-size:20px;text-align:center;letter-spacing:.2em">
          </div>
          <div class="form-group">
            <div class="label">主持人密碼</div>
            <input class="input" type="password" id="hostPassword" placeholder="建立房間時設定的密碼">
          </div>
          <button class="btn btn-primary btn-full mt-8" onclick="rejoinRoom()">繼續場次</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
  SCREEN 3：房間已建立（分享）
════════════════════════════════════════════════════════════════════ -->
<div class="screen" id="screen-room-created">
  <div class="page-center z-1">
    <div style="width:100%;max-width:420px;text-align:center">
      <div class="title-lg mb-8">房間已建立 🎉</div>
      <div class="subtitle mb-24">將以下資訊分享給玩家</div>

      <div class="card mb-12">
        <div class="label">房間碼</div>
        <div class="room-code-display" id="displayRoomCode">———</div>
        <button class="btn btn-ghost btn-sm mt-8" onclick="copyRoomCode()">📋 複製</button>
      </div>

      <div class="card mb-12">
        <div class="label">玩家加入連結</div>
        <div style="font-size:12px;color:var(--text2);word-break:break-all;margin:8px 0" id="joinLink">—</div>
        <button class="btn btn-secondary btn-sm" onclick="copyJoinLink()">📋 複製連結</button>
      </div>

      <div id="waitingPlayers" class="card mb-16">
        <div class="flex justify-between items-center mb-8">
          <div class="label">等待玩家加入</div>
          <div class="badge" style="background:rgba(107,255,184,0.1);color:var(--green)" id="playerCount">0 人</div>
        </div>
        <div id="waitingPlayerList" style="font-size:13px;color:var(--text3)">尚無玩家加入…</div>
      </div>

      <button class="btn btn-primary btn-full" onclick="startGame()">🎮 開始遊戲</button>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
  SCREEN 4：主持人儀表板
════════════════════════════════════════════════════════════════════ -->
<div class="screen" id="screen-dashboard">
  <div class="header">
    <div>
      <div class="header-logo">🌌 身心靈桌遊</div>
      <div class="header-room" id="dashRoomCode">房間碼：———</div>
    </div>
    <div class="header-spacer"></div>
    <div class="header-status" id="dashStatus">遊戲中</div>
  </div>

  <!-- 玩家分頁 -->
  <div class="player-nav" id="playerNav">
    <!-- 動態生成 -->
  </div>

  <div class="dashboard-content" id="dashboardContent">
    <!-- 動態生成玩家詳情 -->
  </div>

  <div class="dashboard-footer">
    <button class="btn btn-secondary btn-sm" onclick="showAddCardModal()">＋ 加牌</button>
    <button class="btn btn-secondary btn-sm" onclick="showGuideModal()">💬 引導問題</button>
    <button class="btn btn-secondary btn-sm" onclick="addNobleToken()">🌟 貴人代幣</button>
    <button class="btn btn-secondary btn-sm" onclick="checkPassCondition()">✅ 過關檢查</button>
    <div class="header-spacer"></div>
    <button class="btn btn-gold btn-sm" onclick="endGameAndGenerate()">🔮 結束並生成解讀</button>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
  SCREEN 5：玩家入口
════════════════════════════════════════════════════════════════════ -->
<div class="screen" id="screen-player-entry">
  <div class="page-center z-1">
    <div style="width:100%;max-width:420px">
      <button class="btn btn-ghost btn-sm mb-16" onclick="showScreen('screen-welcome')">← 返回</button>
      <div class="title-lg mb-8">加入遊戲 🌸</div>
      <div class="subtitle mb-16">輸入房間碼與你的別名</div>

      <div class="card">
        <div class="form-group">
          <div class="label">房間碼</div>
          <input class="input" id="playerRoomCode" placeholder="6位房間碼" maxlength="6"
            style="text-transform:uppercase;font-size:22px;text-align:center;letter-spacing:.25em"
            oninput="this.value=this.value.toUpperCase()">
        </div>
        <div class="form-group">
          <div class="label">你的別名</div>
          <input class="input" id="playerAlias" placeholder="例：小宇宙、月亮" maxlength="12">
        </div>
        <button class="btn btn-primary btn-full mt-8" onclick="joinRoom()">加入 →</button>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
  SCREEN 6：玩家初始資料填寫（多步驟）
════════════════════════════════════════════════════════════════════ -->
<div class="screen" id="screen-player-init">
  <div class="header">
    <div class="header-logo">🌌 身心靈桌遊</div>
    <div class="header-spacer"></div>
    <div style="font-size:12px;color:var(--text3)" id="initStepLabel">步驟 1 / 3</div>
  </div>

  <div class="player-content z-1">
    <div class="step-dots" id="initStepDots">
      <div class="step-dot active" id="dot-0"></div>
      <div class="step-dot" id="dot-1"></div>
      <div class="step-dot" id="dot-2"></div>
    </div>

    <!-- Step 1：基本資料 -->
    <div id="init-step-0" class="fade-in">
      <div class="title-md mb-4">基本資料</div>
      <div class="subtitle mb-16">讓這次旅程更有深度</div>

      <div class="card">
        <div class="form-group">
          <div class="label">這次遊戲的主題／意圖</div>
          <textarea class="input textarea" id="p-theme" placeholder="例：我想探索工作與自我的關係…" rows="3"></textarea>
        </div>
        <div class="form-group">
          <div class="label">你的主要元素</div>
          <div class="radio-group">
            <div class="radio-pill"><input type="radio" name="element" id="el-fire" value="fire"><label for="el-fire">🔥 火</label></div>
            <div class="radio-pill"><input type="radio" name="element" id="el-water" value="water"><label for="el-water">💧 水</label></div>
            <div class="radio-pill"><input type="radio" name="element" id="el-earth" value="earth"><label for="el-earth">🌿 土</label></div>
            <div class="radio-pill"><input type="radio" name="element" id="el-air" value="air"><label for="el-air">🌬 風</label></div>
          </div>
        </div>
        <button class="btn btn-primary btn-full" onclick="initStep(1)">下一步 →</button>
      </div>
    </div>

    <!-- Step 2：人類圖（基本 + 可展開進階） -->
    <div id="init-step-1" class="hidden fade-in">
      <div class="title-md mb-4">人類圖資料</div>
      <div class="subtitle mb-16">基本資料即可，進階選填</div>

      <div class="card">
        <div class="form-group">
          <div class="label">類型 Type</div>
          <select class="input select" id="hd-type">
            <option value="">請選擇</option>
            <option value="projector">投射者 Projector</option>
            <option value="generator">生產者 Generator</option>
            <option value="mani-gen">宣言生產者 Manifesting Generator</option>
            <option value="manifestor">宣言者 Manifestor</option>
            <option value="reflector">反映者 Reflector</option>
          </select>
        </div>
        <div class="form-group">
          <div class="label">策略 Strategy</div>
          <select class="input select" id="hd-strategy">
            <option value="">請選擇</option>
            <option value="wait-invitation">等待邀請</option>
            <option value="wait-response">等待回應</option>
            <option value="inform">告知</option>
            <option value="wait-lunar">等待月相循環</option>
          </select>
        </div>
        <div class="form-group">
          <div class="label">內在權威 Authority</div>
          <select class="input select" id="hd-authority">
            <option value="">請選擇</option>
            <option value="splenic">脾臟直覺</option>
            <option value="sacral">薦骨</option>
            <option value="emotional">情緒太陽神經叢</option>
            <option value="heart">意志力／心</option>
            <option value="self">自我G中心</option>
            <option value="mental">心智投射者</option>
            <option value="lunar">月亮</option>
          </select>
        </div>

        <!-- 進階展開 -->
        <details id="hdAdvanced">
          <summary class="btn btn-ghost btn-sm" style="display:inline-flex;align-items:center;gap:6px;margin-bottom:12px">
            ✦ 展開進階人類圖資料
          </summary>
          <div style="margin-top:12px">
            <div class="form-group">
              <div class="label">Profile（側寫）</div>
              <select class="input select" id="hd-profile">
                <option value="">請選擇</option>
                <option value="1/3">1/3 調查者／殉道者</option>
                <option value="1/4">1/4 調查者／機會主義者</option>
                <option value="2/4">2/4 隱士／機會主義者</option>
                <option value="2/5">2/5 隱士／異端</option>
                <option value="3/5">3/5 殉道者／異端</option>
                <option value="3/6">3/6 殉道者／榜樣</option>
                <option value="4/6">4/6 機會主義者／榜樣</option>
                <option value="4/1">4/1 機會主義者／調查者</option>
                <option value="5/1">5/1 異端／調查者</option>
                <option value="5/2">5/2 異端／隱士</option>
                <option value="6/2">6/2 榜樣／隱士</option>
                <option value="6/3">6/3 榜樣／殉道者</option>
              </select>
            </div>
            <div class="form-group">
              <div class="label">定義 Definition</div>
              <div class="radio-group">
                <div class="radio-pill"><input type="radio" name="hd-def" id="def-single" value="single"><label for="def-single">單一定義</label></div>
                <div class="radio-pill"><input type="radio" name="hd-def" id="def-split" value="split"><label for="def-split">分裂定義</label></div>
                <div class="radio-pill"><input type="radio" name="hd-def" id="def-triple" value="triple"><label for="def-triple">三重分裂</label></div>
                <div class="radio-pill"><input type="radio" name="hd-def" id="def-quad" value="quad"><label for="def-quad">四重分裂</label></div>
              </div>
            </div>
            <div class="form-group">
              <div class="label">主題通道（選填）</div>
              <input class="input" id="hd-channel" placeholder="例：26-44、36-35…">
            </div>
            <div class="form-group">
              <div class="label">太陽閘門／月亮閘門（選填）</div>
              <div class="flex gap-8">
                <input class="input" id="hd-sun" placeholder="太陽 Gate">
                <input class="input" id="hd-moon" placeholder="月亮 Gate">
              </div>
            </div>
            <div class="form-group">
              <div class="label">人生主題（選填）</div>
              <input class="input" id="hd-theme" placeholder="例：個人主題之俠義 4">
            </div>
          </div>
        </details>

        <div class="flex gap-8 mt-8">
          <button class="btn btn-secondary" onclick="initStep(0)">← 返回</button>
          <button class="btn btn-primary" style="flex:1" onclick="initStep(2)">下一步 →</button>
        </div>
      </div>
    </div>

    <!-- Step 3：確認 -->
    <div id="init-step-2" class="hidden fade-in">
      <div class="title-md mb-4">確認資料 ✨</div>
      <div class="subtitle mb-16">確認後即進入遊戲等待室</div>

      <div class="card">
        <div id="initSummary" style="font-size:13px;line-height:1.9;color:var(--text2)"></div>
        <div class="divider"></div>
        <div class="flex gap-8 mt-8">
          <button class="btn btn-secondary" onclick="initStep(1)">← 修改</button>
          <button class="btn btn-primary" style="flex:1" onclick="submitPlayerInit()">確認送出 →</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
  SCREEN 7：玩家遊戲畫面
════════════════════════════════════════════════════════════════════ -->
<div class="screen" id="screen-player-game">
  <div class="header">
    <div>
      <div class="header-logo">🌌 身心靈桌遊</div>
      <div class="header-room" id="playerGameRoom">—</div>
    </div>
    <div class="header-spacer"></div>
    <div style="font-size:12px;color:var(--text2)" id="playerAliasBadge">—</div>
  </div>

  <div class="player-content z-1" id="playerGameContent">

    <!-- 引導問題通知 -->
    <div id="guideNotifArea"></div>

    <!-- 過關進度 -->
    <div class="panel mb-12">
      <div class="flex justify-between items-center mb-8">
        <div class="label">過關進度</div>
        <div style="font-size:12px;color:var(--text3)" id="passStatus">—</div>
      </div>
      <div class="pass-bar" id="passBar">
        <!-- dots -->
      </div>
      <div style="font-size:11px;color:var(--text3);margin-top:6px">
        條件①：塔羅+議題+指引+貴人代幣 ｜ 條件②：≥7張訊息卡 ｜ ≥9張強制過關
      </div>
    </div>

    <!-- 我的牌面 -->
    <div class="panel mb-12">
      <div class="flex justify-between items-center mb-12">
        <div class="label">我的牌面</div>
        <div class="badge" style="background:rgba(160,124,255,0.1);color:var(--accent)" id="myCardCount">0 張</div>
      </div>
      <div class="card-grid" id="myCardsGrid">
        <div style="font-size:13px;color:var(--text3);text-align:center;padding:24px;grid-column:1/-1">等待主持人給牌…</div>
      </div>
    </div>

    <!-- 宇宙送牌提示 -->
    <div id="cosmicGiftArea" class="hidden"></div>

  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
  SCREEN 8：遊戲結束
════════════════════════════════════════════════════════════════════ -->
<div class="screen" id="screen-game-end">
  <div class="header">
    <div class="header-logo">🌌 身心靈桌遊</div>
    <div class="header-spacer"></div>
    <div class="header-status" style="background:rgba(240,201,122,0.1);color:var(--gold);border-color:rgba(240,201,122,0.2)">遊戲結束</div>
  </div>

  <div class="player-content z-1">
    <div class="text-center mb-24">
      <div style="font-size:48px;margin-bottom:12px">🌟</div>
      <div class="title-lg">旅程圓滿完成</div>
      <div class="subtitle mt-4">恭喜你完成這次的身心靈探索</div>
    </div>

    <div class="line-section mb-16">
      <div class="line-logo">💬</div>
      <div class="title-md mb-8">領取你的解讀報告</div>
      <div class="subtitle mb-16">掃描 QR Code 加入 LINE 官方帳號<br>或點選下方按鈕，選擇想要的解讀類型</div>
      <div id="lineQrArea" class="mb-16"></div>
      <a href="https://line.me/R/ti/p/@YOUR_LINE_ID" class="btn btn-gold btn-full" target="_blank">
        📱 加入 LINE 官方帳號
      </a>
    </div>

    <!-- 解讀預覽（如已生成） -->
    <div id="interpretSection" class="hidden">
      <div class="divider"></div>
      <div class="title-md mb-12">解讀報告</div>
      <div class="tabs mb-16" id="interpretTabs">
        <button class="tab active" onclick="switchInterpret('body')">身</button>
        <button class="tab" onclick="switchInterpret('mind')">心</button>
        <button class="tab" onclick="switchInterpret('spirit')">靈</button>
        <button class="tab" onclick="switchInterpret('all')">綜合</button>
      </div>
      <div id="interpretContent" class="panel" style="font-size:14px;line-height:1.9;color:var(--text2)"></div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
  MODALS
════════════════════════════════════════════════════════════════════ -->

<!-- 加牌 Modal -->
<div class="modal-overlay" id="modalAddCard">
  <div class="modal">
    <button class="modal-close" onclick="closeModal('modalAddCard')">✕</button>
    <div class="title-md mb-16">＋ 給玩家加牌</div>

    <div class="form-group">
      <div class="label">選擇玩家</div>
      <select class="input select" id="addCardPlayer"></select>
    </div>
    <div class="form-group">
      <div class="label">牌型</div>
      <select class="input select" id="addCardType" onchange="onCardTypeChange()">
        <option value="explore">探索卡（大阿爾克納）</option>
        <option value="truth">真相卡（小阿爾克納）</option>
        <option value="topic">議題卡</option>
        <option value="guide">指引卡</option>
        <option value="fortune">命運之輪</option>
